{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/webcity/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/webcity/",
      "destination": "/index.html"
    },
    {
      "source": "/webcity",
      "destination": "/index.html"
    },
    {
      "source": "/webcity/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/webcity/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
