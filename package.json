{
  "name": "webcity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "npm run icons && npm run typecheck && vite build",
    "preview": "vite preview --host",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "icons": "node scripts/generateIcons.ts",
    "test:coverage": "vitest run --coverage",
    "assets:sample": "node scripts/generateAssetSample.ts",
    "assets:compress": "node scripts/compressAsset.ts",
    "assets:models": "node scripts/runModelBuild.ts",
    "assets:audit": "node scripts/auditArt.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "@preact/signals": "2.11.3",
    "idb": "8.0.4",
    "preact": "11.0.0",
    "simplex-noise": "4.0.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "meshoptimizer": "1.1.1",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
